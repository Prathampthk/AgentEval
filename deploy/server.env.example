# Optional non-secret Compose settings for the future private server.
# Copy without replacing existing work to .local/server.env after choosing values.
# Add --env-file .local/server.env AFTER the database and owner env files.
# The SSH hostname/provider/offsite destination belong in server-plan.json, not here.
AGENTEVAL_TLS_PORT=8443
AGENTEVAL_QUEUE_CAPACITY=1000
# Database credentials: generate on the eventual server with scripts/compose_env.py.
# Owner credential: generate on that server with scripts/create_access_token.py.
# No Gemini key belongs here. Default mode is simulated; live activation additionally
# requires an approved persistent request policy and compose.server-live.yaml.
