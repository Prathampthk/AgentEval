[Unit]
Description=Encrypted AgentEval snapshot with local restore verification
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
User=agenteval
WorkingDirectory=/opt/agenteval
ExecStart=/opt/agenteval/.venv/bin/python scripts/backup_private_server.py --project agenteval-private
UMask=0077
TimeoutStartSec=30min
NoNewPrivileges=true
PrivateTmp=true
